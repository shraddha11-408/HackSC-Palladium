[Unit]
Description=Palladium video review workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/safesc
EnvironmentFile=/opt/safesc/.env
ExecStart=/opt/safesc/.venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --workers 1 --ws-max-size 2097152
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group

[Install]
WantedBy=multi-user.target
